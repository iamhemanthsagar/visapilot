# VisaPilot — Environment Variables
# Copy this file to .dev.vars and fill in your keys.
# Never commit .dev.vars to Git.

# ─── Cloud AI Providers ───────────────────────────────────────────────────────
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/auto"

# ─── Google AI Studio (Gemini) ────────────────────────────────────────────────
# Variable Name: GEMINI_API_KEY (or GOOGLE_AI_STUDIO_KEY)
# Fast, low-cost models: gemini-1.5-flash, gemini-2.5-flash, or custom
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

COHERE_API_KEY=""
COHERE_MODEL="command-a-plus-05-2026"

MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-medium-3-5"

NVIDIA_NIM_API_KEY_1=""
NVIDIA_MODEL_1="z-ai/glm-5.3"

NVIDIA_NIM_API_KEY_2=""
NVIDIA_MODEL_2="z-ai/glm-5.3-flash"

# ─── Local LLM — LM Studio (Development Only) ────────────────────────────────
# Steps to use:
#   1. Open LM Studio → Local Server → load a model → Start Server
#   2. Set USE_LOCAL_MODEL=true below
#   3. Set LOCAL_LLM_MODEL to the exact model name shown in LM Studio
#   4. Restart the dev server (npm run dev)
#
# To go back to cloud:  set USE_LOCAL_MODEL=false  (no other changes needed)
# In production:        leave these 3 lines out entirely
USE_LOCAL_MODEL="false"
LOCAL_LLM_ENDPOINT="http://127.0.0.1:1234/v1/chat/completions"
LOCAL_LLM_MODEL="qwen3-8b"
